# ================================================================
#  .env — Tamil Tanglish News Bot — Environment Variables
#  Copy this file to .env and fill in your actual API keys
#  NEVER commit your .env file to GitHub!
# ================================================================

# ── OpenAI (GPT-4o-mini for Tamil Tanglish content) ──────────────
# Get at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-openai-key-here

# ── Google Gemini (for AI image background generation) ───────────
# Get at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# ── NewsAPI (primary news source) ────────────────────────────────
# Get at: https://newsapi.org (free plan: 100 req/day)
NEWS_API_KEY=your-newsapi-key-here

# ── GNews (fallback news source) ─────────────────────────────────
# Get at: https://gnews.io (free plan: 100 req/day)
GNEWS_API_KEY=your-gnews-api-key-here

# ── Instagram Graph API ───────────────────────────────────────────
# Requires: Professional IG account + connected Facebook Page
# Get token at: https://developers.facebook.com → Graph API Explorer
# Permissions needed: instagram_basic, instagram_content_publish, pages_read_engagement
IG_ACCESS_TOKEN=your-long-lived-instagram-access-token
IG_USER_ID=your-instagram-business-user-id

# ── ImgBB (free image hosting — required for IG Graph API) ───────
# Get at: https://api.imgbb.com (free: 1000 uploads/month)
IMGBB_API_KEY=your-imgbb-api-key-here

# ── Flask port (Replit auto-assigns, keep as 5000) ────────────────
PORT=5000
